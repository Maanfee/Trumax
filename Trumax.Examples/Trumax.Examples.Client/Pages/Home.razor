@page "/"

<PageTitle>Query View</PageTitle>

<MudButton Variant="Variant.Filled" OnClick="OpenSolutionDialog" StartIcon="@Icons.Material.Filled.Source" Color="Color.Error">Solution</MudButton>

@code {

    #region - Solution -

    private async Task OpenSolutionDialog()
    {
        DialogParameters DialogParameters = new DialogParameters();

        var dialog = await Dialog!.ShowAsync<DialogSolution>(string.Empty, DialogParameters,
            new DialogOptions()
            {
                NoHeader = true,
                MaxWidth = MaxWidth.ExtraExtraLarge,
                FullWidth = true,
                Position = DialogPosition.Center,
                BackgroundClass = "Dialog-Blur",
                CloseOnEscapeKey = true,
            });
    }

    #endregion

}
